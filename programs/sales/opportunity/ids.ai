# opp_ids.ai — typed row keys for the opportunity table: ids and values
# as real list<i64> emits, ordered by id.

entity opportunity {
id identity
owner_id i64
business_id i64
title string
need string
stage string
probability i64
value i64
next_action string
}

main

node 001
op system.read

node 002
op session.verify
input 001
output i64

node 003
op data.list
entity opportunity
column id
where owner_id
input 002
output list<i64>

node 004
op data.list
entity opportunity
column value
where owner_id
input 002
output list<i64>

node 005
op emit
input 003

node 006
op emit
input 004
