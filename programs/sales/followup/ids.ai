# fu_ids.ai — typed ids for the follow-up list (emit returns real
# list<i64> to the host; the done button targets ids, not positions).

entity followup {
id identity
owner_id i64
business_id i64
action string
due_date string
status string
}

main

node 001
op system.read

node 002
op session.verify
input 001
output i64

node 003
op data.list
entity followup
column id
where owner_id
input 002
output list<i64>

node 004
op emit
input 003
