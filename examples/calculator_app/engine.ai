# The calculation core of the 2066 calculator app, authored as a semantic
# program. Compiled to JavaScript (library mode) for the browser UI and to
# Python for the CLI — one semantic program, two backends (roadmap §10/§4.10).
#
#   python -m runtime run examples/calculator_app/engine.ai           # self-test
#   python -m runtime export examples/calculator_app/engine.ai \
#       --target javascript --library --out examples/calculator_app/engine.js
#   python -m runtime export examples/calculator_app/engine.ai --target python
#
# calculate(a, b, op) returns a canonical display string; division by zero
# and unknown operators return readable errors instead of crashing.

