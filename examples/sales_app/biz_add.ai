# biz_add.ai — register a business with a deterministic lead score.
# in: session_token, name, category, city, phone, website, tier
# out: "ok:<id>" or "error E409: duplicate business name"
#
# score = tier*30 + has_website*20 + has_phone*10 — computed in-graph,
# NOT by a model: the same business always scores the same, everywhere.

entity business {
id identity
owner_id i64
name string
category string
city string
phone string
website string
tier i64
score i64
stage string
}

main

node 001
op system.read

node 002
op session.verify
input 001
output i64

node 003
op system.read

node 004
op system.read

node 005
op system.read

node 006
op system.read

node 007
op system.read

node 008
op system.read

node 009
op cast
input 008
output i64

node 010
op const
type string
value ""

node 011
op compare
mode ne
input 006 010
output bool

node 012
op const
type i64
value 1

node 013
op const
type i64
value 0

node 014
op branch
input 011 012 013
output i64

node 015
op compare
mode ne
input 007 010
output bool

node 016
op branch
input 015 012 013
output i64

