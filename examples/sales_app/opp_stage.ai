# opp_stage.ai — the pipeline state machine, in-graph.
# in: session_token, opp_id, from_stage, to_stage
# out: "ok:<rows>" or structured error
#
# Enforced HERE, not by the UI: only the owner may move it, from_stage
# must equal the current stage, from must be {new, qualified, proposal}
# (won/lost are terminal), to must be {qualified, proposal, won, lost}.

entity opportunity {
id identity
owner_id i64
business_id i64
title string
need string
stage string
probability i64
value i64
next_action string
}

main

