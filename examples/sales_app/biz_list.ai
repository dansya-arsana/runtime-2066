# biz_list.ai — the caller's businesses as 4 newline-separated CSV lines:
# names, cities, categories, stages. (No loops in V0: the program emits
# parallel columns; the shell zips them by index. Ids and scores — i64
# columns — arrive as typed lists via biz_ids.ai, never through strings.)

entity business {
id identity
owner_id i64
name string
category string
city string
phone string
website string
tier i64
score i64
stage string
}

main

node 001
op system.read

node 002
op session.verify
input 001
output i64

node 003
op const
type string
value ","

node 004
op data.list
entity business
column name
where owner_id
input 002
output list<string>

node 006
op data.list
entity business
column city
where owner_id
input 002
output list<string>

node 007
op data.list
entity business
column category
where owner_id
input 002
output list<string>

node 009
op data.list
entity business
column stage
where owner_id
input 002
output list<string>

node 010
op const
type string
value "\n"

node 011
op list.join
input 004 003
output string

node 013
op list.join
input 006 003
output string

node 014
op list.join
input 007 003
output string

node 016
op list.join
input 009 003
output string

node 017
op concat
input 011 010
output string

node 020
op concat
input 017 013
output string

node 021
op concat
input 020 010
output string

node 022
op concat
input 021 014
output string

node 023
op concat
input 022 010
output string

node 026
op concat
input 023 016
output string

node 027
op system.write
input 026
